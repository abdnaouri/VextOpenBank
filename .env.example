# ==============================================================================
# VextOpenBank Environment Variables Template
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ==============================================================================

# Service Info
PROJECT_NAME="VextOpenBank API"
VERSION="1.0.0"
PORT=8000
HOST="0.0.0.0"

# Kony MobileFabric Gateway & App Keys
MOBILEFABRIC_URL="https://cfgmbapp.example.com:8443"
MOBILEFABRIC_APP_KEY="your_mobilefabric_app_key_here"
MOBILEFABRIC_APP_SECRET="your_mobilefabric_app_secret_here"
MOBILEFABRIC_APP_ID="your_mobilefabric_app_id_here"
MOBILEFABRIC_BASE_ID="your_mobilefabric_base_id_here"
MOBILEFABRIC_APP_NAME="CFGRetailBanking"
MOBILEFABRIC_SDK_VERSION="9.7.52"

# Onegini / Token Registration Server
TOKEN_SERVER_URL="https://mbregister.example.com"

# Airlock IAM Web Portal (Session Keep-Alive Bypass)
AIRLOCK_PORTAL_URL="https://clients.example.com"
AIRLOCK_USERNAME="your_airlock_username"
AIRLOCK_PASSWORD="your_airlock_password"

# Hardware / Device Identification (Simulated Device Keystore Profile)
DEVICE_ID="your_device_uuid_here"
CLIENT_ID="your_client_id_here"
PROFILE_ID="your_profile_id_here"
USER_AGENT="CFGBankApp/5.5.2 (Linux; U; Android 14; KB2003 Build/UKQ1.230924.001)"

# Local Storage / Fallback Database Path
LOCAL_STORAGE_PATH="/tmp/localstorage.db"
FALLBACK_ACCOUNT_RIB="051780000000000000000057"

# Optional Network Proxy (e.g. Charles / Burp / mitmproxy for debugging)
# Leave blank to disable
PROXY_URL=""

# Customer Profile Data (Overrides fallback defaults)
CLIENT_NAME="Client CFG"
CLIENT_CODE="00012345"
USER_ID="USR12345"
CLIENT_EMAIL="client@example.com"
CLIENT_PHONE="+212600000000"
VEXT_PROFILE_JSON=""

# EnvoiSMS.ma Webhook Reconciliation Secret
ENVOISMS_VEXT_SECRET="your_envoisms_webhook_hmac_secret"
ENVOISMS_API_BASE="https://api.envoisms.ma"

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN="your_cloudflare_zero_trust_tunnel_token"
