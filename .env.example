# ==============================================================================
# VextOpenBank & Cloudflare Edge Environment Configuration Example
# Copy to `.env` and fill in secrets before deploying.
# ZERO HARDCODED SECRETS POLICY: No sensitive values are hardcoded in source code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Edge Shield & Internal Security
# ------------------------------------------------------------------------------
# Cryptographic Origin Shield token shared between Cloudflare Worker and VextOpenBank.
# Injected by Cloudflare Worker as `X-Origin-Shield` header.
ORIGIN_SHIELD_SECRET=your_origin_shield_cryptographic_secret_here

# Internal Administrative API Key for authorized direct calls or worker bypass.
# Passed in `X-Vext-Key` or `Authorization: Bearer <KEY>`.
VEXT_INTERNAL_API_KEY=your_internal_api_key_here

# ------------------------------------------------------------------------------
# 2. CFG Bank MobileFabric Credentials
# ------------------------------------------------------------------------------
# Extracted from CFGBankApp Android APK assets / runtime config
MOBILEFABRIC_APP_KEY=your_kony_mobilefabric_app_key
MOBILEFABRIC_APP_SECRET=your_kony_mobilefabric_app_secret
MOBILEFABRIC_APP_ID=your_kony_mobilefabric_app_id
MOBILEFABRIC_BASE_ID=your_kony_mobilefabric_base_id
MOBILEFABRIC_APP_NAME=CFGRetailBanking
MOBILEFABRIC_SDK_VERSION=9.7.52

# Gateway URLs
TOKEN_SERVER_URL=https://mbregister.example.com
MOBILEFABRIC_URL=https://cfgmbapp.example.com:8443
WEB_PORTAL_URL=https://clients.example.com
AIRLOCK_PORTAL_URL=https://clients.example.com

# ------------------------------------------------------------------------------
# 3. Airlock IAM Portal Keep-Alive Credentials
# ------------------------------------------------------------------------------
AIRLOCK_USERNAME=your_airlock_portal_username
AIRLOCK_PASSWORD=your_airlock_portal_password

# ------------------------------------------------------------------------------
# 4. EnvoiSMS.ma Automated Bank Bridge
# ------------------------------------------------------------------------------
# Shared secret for HMAC-SHA256 signature calculation on bank confirmation webhooks
ENVOISMS_VEXT_SECRET=your_envoisms_webhook_hmac_secret
ENVOISMS_API_BASE=https://api.envoisms.ma

# ------------------------------------------------------------------------------
# 5. Device Profile & Network Settings
# ------------------------------------------------------------------------------
# Hardware device profile (persisted in /tmp/vext_persistent_device_profile.json if left blank)
# DEVICE_ID=
# CLIENT_ID=
# PROFILE_ID=
USER_AGENT=CFGBankApp/5.5.2 (Linux; U; Android 14; KB2003 Build/UKQ1.230924.001)

# Egress proxy (set to empty to connect directly)
PROXY_URL=

# Local SQLite databases
LOCAL_STORAGE_PATH=/tmp/localstorage.db
EXCHANGES_LOG_PATH=work/logs/exchanges.jsonl

# Server listener
PORT=8000
HOST=0.0.0.0
